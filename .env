# =============================================
# Configuração do Kaomoji Collector GitHub App
# =============================================

# 🔑 Credenciais do GitHub App (obrigatórias)
APP_ID=123456                       # ID do seu GitHub App (encontrado em Settings > Developer settings)
PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----..."  # Chave privada do app (gerada durante a criação)
WEBHOOK_SECRET=secreto_aleatorio     # Segredo do webhook (definido nas configurações do app)

# 🌐 Configurações de Host (opcional para desenvolvimento local)
WEBHOOK_PROXY_URL=https://smee.io/seu-canal  # URL do proxy SMEE (para webhooks locais)
NODE_ENV=development                 # development | production

# 📦 Banco de Dados (opcional - se usar PostgreSQL, SQLite, etc.)
# DATABASE_URL=postgres://user:pass@localhost:5432/kaomoji_db
# SQLITE_PATH=./data/kaomojis.db

# 🚀 Configurações de Deploy (exemplo para Vercel/AWS)
# VERCEL_TOKEN=abc123                # Token da Vercel (para deploy automático)
# AWS_ACCESS_KEY_ID=AKIA...          # Caso use AWS Lambda
# AWS_SECRET_ACCESS_KEY=abc...       # Caso use AWS Lambda

# 🔍 Debug (opcional)
# DEBUG=probot:*
# LOG_LEVEL=info                     # debug | info | warn | error

# =============================================
# Como usar:
# 1. Renomeie este arquivo para `.env`
# 2. Preencha os valores necessários
# 3. NUNCA comite o `.env` real no Git!
# =============================================
